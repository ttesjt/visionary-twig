{
  "name": "@frontend/workspace-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable frontend framework and application templates",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/run-app.mjs start",
    "build:packages": "node scripts/run-workspace.mjs build:packages",
    "build": "node scripts/run-app.mjs build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/run-workspace.mjs lint",
    "lint:fix": "node scripts/run-workspace.mjs lint --fix",
    "typecheck": "node scripts/run-workspace.mjs typecheck",
    "test": "node scripts/run-workspace.mjs test",
    "test:watch": "node scripts/run-workspace.mjs test --watch",
    "test:coverage": "node scripts/run-workspace.mjs test --coverage",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "validate": "node scripts/run-workspace.mjs validate",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "test:e2e:theme-policy": "node scripts/test-theme-policy.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "template:clone": "node scripts/clone-template.mjs",
    "text:prepare": "node scripts/prepare-app.mjs --kind text",
    "text:check": "node scripts/prepare-app.mjs --kind text --check",
    "config:prepare": "node scripts/prepare-app.mjs --kind config",
    "config:check": "node scripts/prepare-app.mjs --kind config --check",
    "app:prepare": "node scripts/prepare-app.mjs --kind app",
    "app:check": "node scripts/prepare-app.mjs --kind app --check",
    "bootstrap": "node scripts/bootstrap.mjs",
    "apps:list": "node scripts/list-apps.mjs",
    "content:prepare": "node scripts/prepare-app.mjs --kind content",
    "content:check": "node scripts/prepare-app.mjs --kind content --check",
    "repo:clone": "node scripts/clone-repository.mjs",
    "library:clone": "node scripts/clone-library.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "@frontend/text-catalog": "workspace:*",
    "@frontend/prepared-data": "workspace:*",
    "@frontend/app-config": "workspace:*",
    "zod": "catalog:"
  }
}
