{
  "name": "@frontend/workspace-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable frontend framework and application templates",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "pnpm build:packages && pnpm --filter \"./packages/*\" --parallel --if-present dev",
    "build:packages": "pnpm check:workspace:source && pnpm --filter \"./packages/*\" --if-present build",
    "build": "pnpm build:packages && pnpm check:workspace",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:all": "pnpm check:workspace:source && tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "typecheck": "pnpm build:packages && pnpm typecheck:all",
    "test": "pnpm build:packages && pnpm test:tooling && pnpm -r --if-present test",
    "test:watch": "pnpm check:workspace:source && pnpm -r --parallel --if-present test:watch",
    "test:coverage": "pnpm build:packages && pnpm -r --if-present test:coverage",
    "check:workspace": "node scripts/check-workspace.mjs",
    "validate": "pnpm build:packages && pnpm check:workspace && pnpm format:check && pnpm lint && pnpm typecheck:all && pnpm test",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "check:workspace:source": "node scripts/check-workspace.mjs --source"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
