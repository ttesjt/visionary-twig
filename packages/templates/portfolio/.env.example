# Copy this file to .env.local in this application's root directory.
# UI_THEME_POLICY=selectable
# NEXT_PUBLIC_EVENT_TRACKING_URL=
# SITE_URL=https://site.example.test

# Generated apps default to SQLite and files under .local/portfolio.
# PORTFOLIO_DATA_SOURCE=local
# PORTFOLIO_LOCAL_DIR=.local/portfolio
# For a local Node server connected to remote D1/R2, select cloudflare and supply a Wrangler config.
# PORTFOLIO_DATA_SOURCE=cloudflare
# PORTFOLIO_WRANGLER_CONFIG=.local/portfolio/wrangler.toml

# Email mode is independent from storage. Local mode writes ignored messages.
# For deployed email, choose cloudflare and configure all fields below.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
