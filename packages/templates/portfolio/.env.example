# Copy this file to .env.local in this application's root directory.
# Keep an existing .env.local; fill in only the variables you need.
# These demo credentials work only with the local demo:upstream server.
EXAMPLE_UPSTREAM_URL=http://127.0.0.1:3215/recommendation
EXAMPLE_UPSTREAM_API_KEY=demo-only-key

# UI_THEME_POLICY=selectable
# NEXT_PUBLIC_EVENT_TRACKING_URL=
# NEXT_PUBLIC_* values are public and are inlined during next build.
# Keep API keys in server-only variables, without the NEXT_PUBLIC_ prefix.

# Optional public site origin for canonical, language links and relative share images.
# Set before next build for statically generated pages; rebuild when it changes.
# SITE_URL=https://example.com
