{
  "document": {
    "documentId": "field-notes",
    "schemaVersion": 1,
    "revision": 1,
    "bindings": [
      {
        "nodeId": "heading",
        "targetPath": ["text"],
        "sourcePath": ["publication", "heading"]
      },
      {
        "nodeId": "chapters",
        "targetPath": ["label"],
        "sourcePath": ["publication", "chapters"]
      },
      {
        "nodeId": "chapters",
        "targetPath": ["progressLabel"],
        "sourcePath": ["publication", "progress"]
      },
      {
        "nodeId": "chapters",
        "targetPath": ["items", "0", "label"],
        "sourcePath": ["publication", "overview"]
      },
      {
        "nodeId": "chapters",
        "targetPath": ["items", "1", "label"],
        "sourcePath": ["publication", "study"]
      },
      {
        "nodeId": "study-heading",
        "targetPath": ["text"],
        "sourcePath": ["publication", "study"]
      },
      {
        "nodeId": "overview-copy",
