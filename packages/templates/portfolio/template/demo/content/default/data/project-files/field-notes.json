        "sourcePath": ["publication", "summary"]
      },
      {
        "nodeId": "lake",
        "targetPath": ["image", "alt"],
        "sourcePath": ["publication", "alt"]
      }
    ],
    "data": {
      "root": {},
      "content": [
        {
          "type": "ContentNavigation",
          "props": {
            "id": "chapters",
            "label": "Field log chapters",
            "progressLabel": "Field log reading progress",
            "items": [
              {
                "label": "Overview",
                "href": "#overview"
              },
              {
                "label": "Field study",
                "href": "#field-study"
              }
            ],
            "content": [
              {
                "type": "Anchor",
                "props": {
                  "id": "overview-anchor",
                  "name": "overview",
                  "content": [
                    {
                      "type": "Heading",
                      "props": {
                        "id": "heading",
                        "level": 2,
                        "text": ""
                      }
                    },
                    {
                      "type": "RichText",
                      "props": {
                        "id": "overview-copy",
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "A small web journal for observations made outdoors."
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Anchor",
                "props": {
                  "id": "field-study-anchor",
                  "name": "field-study",
                  "content": [
                    {
                      "type": "Heading",
                      "props": {
                        "id": "study-heading",
                        "level": 2,
                        "text": "Field study"
                      }
                    },
                    {
                      "type": "MediaFigure",
                      "props": {
                        "id": "lake",
                        "image": {
                          "id": "lake-image",
                          "src": "/samples/portfolio/lake.jpg",
                          "alt": "A quiet lake among hills",
                          "width": 960,
                          "height": 640
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "context": {
