{
  "extends": "../../../tsconfig.react.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "test/examples/**/*",
    "test/errors/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "text-resources.config.ts",
    "config.config.ts",
    "config/**/*.ts",
    "content-resources.config.ts",
    "content/**/*.ts",
    "scripts/examples/**/*.ts",
    "template/test/**/*"
  ],
  "exclude": ["node_modules", ".next/cache"]
}
