{
  "name": "@frontend/studio",
  "version": "0.1.0",
  "description": "Studio editing tools, document contracts and workspaces",
  "private": true,
  "type": "module",
  "workspaceKind": "node-library",
  "exports": {
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/records": {
      "types": "./dist/data/records.d.ts",
      "import": "./dist/data/records.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "dev": "tsc --build tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:",
    "@frontend/ui-document": "workspace:*"
  },
  "workspaceEntrypoints": {
    "./data": "pure",
    "./data/records": "pure"
  }
}
