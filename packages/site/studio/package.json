{
  "name": "@frontend/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio editing tools, document contracts and workspaces",
  "exports": {
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/records": {
      "types": "./dist/data/records.d.ts",
      "import": "./dist/data/records.js"
    },
    "./preview-options": {
      "types": "./dist/ui/preview/preview-options.d.ts",
      "import": "./dist/ui/preview/preview-options.js"
    },
    "./issues": {
      "types": "./dist/ui/issues.d.ts",
      "import": "./dist/ui/issues.js"
    },
    "./text-catalog": {
      "types": "./dist/ui/text-catalog.d.ts",
      "import": "./dist/ui/text-catalog.js"
    },
    "./shell": {
      "types": "./dist/ui/shell.d.ts",
      "import": "./dist/ui/shell.js"
    },
    "./shell/text-catalog": {
      "types": "./dist/ui/shell/text-catalog.d.ts",
      "import": "./dist/ui/shell/text-catalog.js"
    },
    "./shell/registry": {
      "types": "./dist/ui/shell/registry.d.ts",
      "import": "./dist/ui/shell/registry.js"
    },
    "./session": {
      "types": "./dist/ui/session.d.ts",
      "import": "./dist/ui/session.js"
    },
    "./editor": {
      "types": "./dist/ui/editor.d.ts",
      "import": "./dist/ui/editor.js"
    },
    "./files": {
      "types": "./dist/ui/files.d.ts",
      "import": "./dist/ui/files.js"
    },
    "./publishing": {
      "types": "./dist/ui/publishing.d.ts",
      "import": "./dist/ui/publishing.js"
    },
    "./json-editor": {
      "types": "./dist/ui/json-editor.d.ts",
      "import": "./dist/ui/json-editor.js"
    },
    "./json-editor/text-catalog": {
      "types": "./dist/ui/json-editor/text-catalog.d.ts",
      "import": "./dist/ui/json-editor/text-catalog.js"
    },
    "./viewer": {
      "types": "./dist/ui/viewer.d.ts",
      "import": "./dist/ui/viewer.js"
    },
    "./catalog": {
      "types": "./dist/ui/catalog.d.ts",
      "import": "./dist/ui/catalog.js"
    },
    "./workspace": {
      "types": "./dist/ui/workspace.d.ts",
      "import": "./dist/ui/workspace.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell.css": "./src/styles/shell.css",
    "./editor.css": "./src/styles/editor.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "dev": "tsc --build tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "workspaceKind": "react-library",
  "dependencies": {
    "@frontend/puck-adapter": "workspace:*",
    "@frontend/ui": "workspace:*",
    "@frontend/text-catalog": "workspace:*",
    "zod": "catalog:",
    "@frontend/content-blocks": "workspace:*",
    "@frontend/ui-document": "workspace:*"
  },
  "workspaceEntrypoints": {
    "./data": "pure",
    "./data/records": "pure"
  }
}
